#!/bin/bash
# ============================================================
# Katana PBS job: Block 2 - Vanilla VAE
# 400 epochs, latent 32, seq_len=384, KL weight 5e-4, ReduceLROnPlateau
# Wall time budget: 1 hour (V100 ~15min, A100 ~10min)
# ============================================================
#PBS -N battery_vanilla_vae
#PBS -l select=1:ncpus=8:ngpus=1:mem=46gb
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o logs/01_train_vanilla_vae.log

set -e

cd "$PBS_O_WORKDIR"
mkdir -p logs outputs/ckpt/vanilla_vae

source scripts/katana/activate_env.sh

echo "============================================================"
echo "Job:        01_train_vanilla_vae"
echo "Started:    $(date)"
echo "Host:       $(hostname)"
nvidia-smi -L 2>/dev/null || true
echo "============================================================"

python scripts/train_vanilla_vae.py

echo "============================================================"
echo "Finished:   $(date)"
echo "Output:     outputs/ckpt/vanilla_vae/vanilla_vae.pt"
echo "============================================================"
ls -lh outputs/ckpt/vanilla_vae/vanilla_vae.pt
