#!/bin/bash
# ============================================================
# Katana PBS job: Block 2 - Resampled-DE (a.k.a. DE-DDPM in paper)
# 400 epochs, fixed seq_len=500, ConvTranspose2d upsampling
# Wall time budget: 5 hours (V100 ~2.5h, A100 ~1.5h)
# ============================================================
#PBS -N battery_resampled_de
#PBS -l select=1:ncpus=8:ngpus=1:mem=46gb
#PBS -l walltime=05:00:00
#PBS -j oe
#PBS -o logs/01_train_resampled_de.log

set -e

cd "$PBS_O_WORKDIR"
mkdir -p logs outputs/ckpt/resampled_de

source scripts/katana/activate_env.sh

echo "============================================================"
echo "Job:        01_train_resampled_de"
echo "Started:    $(date)"
echo "Host:       $(hostname)"
nvidia-smi -L 2>/dev/null || true
echo "============================================================"

python scripts/train_resampled_de.py

echo "============================================================"
echo "Finished:   $(date)"
echo "Output:     outputs/ckpt/resampled_de/final.pt"
echo "============================================================"
ls -lh outputs/ckpt/resampled_de/final.pt
