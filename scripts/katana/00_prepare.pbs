#!/bin/bash
# ============================================================
# Katana PBS job: Block 1 - data preparation
# Runs prepare_data.py to build prepared_data.pkl from XJTU .mat files.
# CPU-only, fast.
# ============================================================
#PBS -N battery_prepare
#PBS -l select=1:ncpus=2:mem=8gb
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o logs/00_prepare.log

set -e

cd "$PBS_O_WORKDIR"
mkdir -p logs outputs

source scripts/katana/activate_env.sh

echo "============================================================"
echo "Job:        00_prepare"
echo "Started:    $(date)"
echo "Host:       $(hostname)"
echo "Workdir:    $PBS_O_WORKDIR"
echo "============================================================"

python scripts/prepare_data.py

echo "============================================================"
echo "Finished:   $(date)"
echo "Output:     outputs/prepared_data.pkl"
echo "============================================================"
ls -lh outputs/prepared_data.pkl
